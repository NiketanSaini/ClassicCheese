# Copy to .env and adjust if your local setup differs, then `export $(cat .env | xargs)`
# or source it however you prefer — these are plain env vars, no dotenv
# loader is wired into the Go code.

REDIS_ADDR=localhost:6379
MYSQL_DSN=root:password@tcp(localhost:3306)/leaderboard?parseTime=true
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=score-events
HTTP_PORT=8080
AGGREGATION_INTERVAL_SECONDS=5
RANK_CROSS_THRESHOLD=3
