<mxfile host="app.diagrams.net" agent="Claude" version="24.0.0" type="device">
  <diagram name="Leaderboard Architecture" id="leaderboard-arch">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="950" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="Distributed Real-Time Leaderboard &#8212; Event-Driven Architecture" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1A1A1A;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="1000" height="34" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Go &#183; Redis &#183; RabbitMQ &#183; MySQL &#183; WebSockets &#8212; every service talks only through infrastructure, never directly" style="text;html=1;fontSize=13;fontStyle=2;align=left;verticalAlign=middle;fontColor=#777777;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="1000" height="20" as="geometry" />
        </mxCell>

